# Variables para `docker compose` (copia este archivo como .env; .env NO se sube a GitHub).

# Contraseña de PostgreSQL. Usa solo letras y números (va dentro de una URL).
POSTGRES_PASSWORD=cambia-esta-clave-1234

# Secreto para firmar las sesiones: mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REEMPLAZA-ESTE-SECRETO-POR-UNO-REAL-DE-48-BYTES

# Dirección pública del sitio (la API solo acepta peticiones que vengan de aquí).
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Cuántas instancias de Express se levantan (balanceadas por Nginx).
API_REPLICAS=3
