# Copia este archivo como .env y ajusta los valores. El archivo .env NO se sube a Git.
NODE_ENV=development
PORT=3000
# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS
# Si tu contraseña tiene caracteres especiales (@ : / # ? %), deben codificarse (ej. @ -> %40).
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/taskflow

# Secreto con el que se firman las sesiones. Debe ser largo y aleatorio, y distinto en producción.
# Genéralo con este comando y pega el resultado aquí:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REEMPLAZA_ESTO_POR_UN_SECRETO_GENERADO
